# Copy to backend/.env and fill in real values. NEVER commit the real .env.

# ── Environment ──────────────────────────────────────────────────────────
# "development" (default) or "production". Production:
#   - refuses to serve mock quote data (see ALLOW_MOCK_FALLBACK)
#   - refuses to start without a real OPENAI_API_KEY
#   - hides /docs and /redoc, and adds a Content-Security-Policy header
ENVIRONMENT=development

# ── LLM ──────────────────────────────────────────────────────────────────
# OpenAI-compatible API (works with OpenAI, DeepSeek, Moonshot, Together, vLLM, etc.)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Fail a hung model call after 20s instead of the SDK default (10min), and
# cap the completion so a runaway loop can't rack up tokens.
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=300
# "json_object" (broad provider support) or "json_schema" (OpenAI Structured
# Outputs; stricter, not every compatible provider implements it).
LLM_RESPONSE_FORMAT=json_object

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Storage: "sqlite" (default) or "supabase" ────────────────────────────
STORAGE_BACKEND=sqlite

# SQLite — used only when STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite:///./stocksight.db

# Supabase — used only when STORAGE_BACKEND=supabase
# Service role key MUST come from Dashboard → Settings → API → service_role.
# Do NOT use the publishable / anon key here — it can't bypass RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# ── Quote provider ───────────────────────────────────────────────────────
# "yfinance" (live) or "mock" (always deterministic demo data).
STOCK_DATA_PROVIDER=yfinance

# When True, a failed live fetch silently falls back to demo data.
# Set to False in production so an outage surfaces as an error instead of
# silently serving fake prices (and /api/analyze refuses mock-derived rows).
ALLOW_MOCK_FALLBACK=True

# Quote cache TTL in seconds — protects yfinance from rate limits
QUOTE_CACHE_TTL=30
# Max entries in the in-memory quote cache (LRU-evicted)
QUOTE_CACHE_MAX_ENTRIES=512

# ── Rate limiting / cost controls ────────────────────────────────────────
# Per-IP sliding window, per minute. 0 disables a limit.
RATE_LIMIT_ANALYZE_PER_MIN=10
RATE_LIMIT_QUOTE_PER_MIN=60
# Hard global daily cap on analyses (DB-backed, survives restarts). 0 disables.
ANALYZE_DAILY_CAP=0

# Return a prior analysis instead of paying for a new LLM call when the same
# quote is analyzed again (quotes carry a fetched_at timestamp).
ANALYSIS_REUSE=False

# ── API docs ─────────────────────────────────────────────────────────────
ENABLE_API_DOCS=True