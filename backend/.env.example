# Copy to backend/.env and fill in real values. NEVER commit the real .env.

# OpenAI-compatible API (works with OpenAI, DeepSeek, Moonshot, Together, vLLM, etc.)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CORS: comma-separated list of frontend origins
CORS_ORIGINS=http://localhost:5173

# SQLite file (relative to backend/ or absolute path)
DATABASE_URL=sqlite:///./stocksight.db

# Quote cache TTL in seconds — protects yfinance from rate limits
QUOTE_CACHE_TTL=30
