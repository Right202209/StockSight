# Copy to backend/.env and fill in real values. NEVER commit the real .env.

# OpenAI-compatible API (works with OpenAI, DeepSeek, Moonshot, Together, vLLM, etc.)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CORS: comma-separated list of frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage backend: "sqlite" (default, local file) or "supabase" (Postgres via supabase-py)
STORAGE_BACKEND=sqlite

# SQLite — used only when STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite:///./stocksight.db

# Supabase — used only when STORAGE_BACKEND=supabase
# Service role key MUST come from Dashboard → Settings → API → service_role.
# Do NOT use the publishable / anon key here — it can't bypass RLS.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Quote cache TTL in seconds — protects yfinance from rate limits
QUOTE_CACHE_TTL=30

# Stock data provider: "yfinance" (live, falls back to mock on failure) or "mock"
STOCK_DATA_PROVIDER=yfinance
